digraph G {
  graph [rankdir=TB, bgcolor="white", margin=0.2, nodesep=0.35, ranksep=0.6];
  node [shape=record, fontname="Arial", fontsize=9];
  edge [fontname="Arial", fontsize=9];

  Producto [label="{Producto| - __codigo: str\l - __nombre: str\l - __precio: float\l| + getters/setters()\l + calcular_precio_final(): float\l}"];
  Cliente [label="{ABSTRACT Cliente| - __identificacion: str\l - __nombre: str\l - __correo: str\l| + getters/setters()\l + mostrar_info(): str\l + calcularDescuento(subtotal): float [abstract]\l}"];
  ClienteMayorista [label="{ClienteMayorista|| + calcularDescuento(subtotal): float\l}"];
  ClienteMinorista [label="{ClienteMinorista|| + calcularDescuento(subtotal): float\l}"];
  ProductoFisico [label="{ProductoFisico| - __peso_kg: float\l - __costo_envio: float\l| + calcular_precio_final(): float\l}"];
  ProductoDigital [label="{ProductoDigital| - __formato: str\l - __tamano_mb: float\l| + calcular_precio_final(): float\l}"];
  Pedido [label="{Pedido| - __numero: str\l - __cliente: Cliente\l - __detalles: list\l| + agregar_producto()\l + calcular_subtotal(): float\l + calcular_descuento(): float\l + calcular_total(): float\l + mostrar_resumen(): str\l}"];
  DetallePedido [label="{DetallePedido| - __producto: Producto\l - __cantidad: int\l| + calcular_subtotal(): float\l}"];

  ProductoFisico -> Producto [arrowhead=empty, label="hereda"];
  ProductoDigital -> Producto [arrowhead=empty, label="hereda"];
  ClienteMayorista -> Cliente [arrowhead=empty, label="hereda / sobrescribe"];
  ClienteMinorista -> Cliente [arrowhead=empty, label="hereda / sobrescribe"];
  Pedido -> Cliente [arrowhead=vee, label="trabaja con abstraccion"];
  Pedido -> DetallePedido [dir=both, arrowtail=diamond, arrowhead=none, label="composicion 1..*"];
  DetallePedido -> Producto [arrowhead=vee, label="producto"];
}
